{
  "name": "dsh-attach",
  "version": "2026.1108.2309",
  "description": "Attach a terminal UI to an already running DeepSeek Harness host: same sessions, same live agents, approvals and questions included.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "tui",
    "terminal",
    "attach"
  ],
  "type": "module",
  "main": "./lib/host.js",
  "types": "./lib/host.d.ts",
  "exports": {
    ".": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client/cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-attach": "./bin/dsh-attach.js"
  },
  "files": [
    "lib",
    "bin",
    "docs",
    "cordis.patch.yml",
    "herdr-plugin.toml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.84.2"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0 <4"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-branches=65 --test-coverage-functions=65 test/*.test.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "lint": "eslint lib bin scripts test",
    "check": "pnpm lint && pnpm check:syntax && pnpm check:docs && pnpm test"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
